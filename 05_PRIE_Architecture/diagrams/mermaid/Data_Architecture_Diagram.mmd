    %% Core Student Identity & Profile
    STUDENT ||--o{ STUDENT_PROFILE_VECTOR : "has snapshots"
    STUDENT ||--o{ ACADEMIC_RECORD : "possesses"
    STUDENT ||--o{ RESUME : "uploads"
    STUDENT ||--o{ INTERVIEW : "completes"
    STUDENT ||--o{ ASSESSMENT : "takes"
    STUDENT ||--o{ LEARNING_EVENT : "emits telemetry"
    STUDENT ||--o{ PREDICTION : "receives"
    STUDENT ||--o{ ROADMAP : "follows"

    %% Profile Vector & Predictions
    STUDENT_PROFILE_VECTOR ||--o{ PREDICTION : "inputs into"
    STUDENT_PROFILE_VECTOR ||--o{ SKILL_GAP : "evaluated against"
    PREDICTION ||--o{ EXPLANATION : "explained by"
    PREDICTION }o--|| MODEL_VERSION : "generated by"

    %% Resumes & Analyses
    RESUME ||--|| RESUME_ANALYSIS : "yields"
    RESUME_ANALYSIS }o--|| JOB_DESCRIPTION : "matched against"

    %% Interviews & Mock Sessions
    INTERVIEW ||--|| INTERVIEW_ANALYSIS : "analyzed as"

    %% Assessments & Adaptive Questions
    ASSESSMENT ||--o{ QUESTION_ATTEMPT : "contains"
    QUESTION ||--o{ QUESTION_ATTEMPT : "tested in"
    QUESTION }o--|| SKILL : "anchored to concept"

    %% Gaps, Recommendations & Roadmaps
    SKILL_GAP ||--o{ RECOMMENDATION : "prioritizes"
    RECOMMENDATION ||--o{ ROADMAP : "compiled into"
    SKILL ||--o{ SKILL_GAP : "identified in"

    %% Experiments & Audits
    EXPERIMENT_REFERENCE ||--o{ PREDICTION : "evaluates"
    EXPERIMENT_REFERENCE ||--o{ MODEL_VERSION : "benchmarks"

    %% Entity Field Definitions
    STUDENT {
        uuid id PK
        string student_id UK
        string email UK
        string institution_code
        string department
        int graduation_year
        timestamp created_at
    }

    STUDENT_PROFILE_VECTOR {
        uuid id PK
        uuid student_id FK
        int version
        float f01_cgpa
        int f02_backlogs_history
        float f03_tier1_course_completion
        int f04_leetcode_problems_solved
        float f05_github_commit_consistency
        float f06_core_cs_dsa_score
        float f07_system_design_score
        int f08_practical_project_count
        float f09_fullstack_competency_score
        float f10_project_quality_score
        float f11_ats_resume_score
        float f12_resume_quantified_bullets_ratio
        float f13_technical_skills_match_ratio
        float f14_mock_interview_score
        float f15_speech_rate_wpm
        float f16_pause_filler_ratio
        float f17_visual_confidence_index
        float f18_weekly_study_hours
        float f19_platform_interaction_frequency
        float f20_assessment_retest_persistence
        float f21_drop_off_hesitation_index
        float f22_roadmap_completion_rate
        timestamp computed_at
    }

    ACADEMIC_RECORD {
        uuid id PK
        uuid student_id FK
        float current_cgpa
        int total_backlogs
        jsonb course_grades
        timestamp last_synced_at
    }

    RESUME {
        uuid id PK
        uuid student_id FK
        string s3_object_key
        string file_hash
        string parsing_status
        timestamp uploaded_at
    }

    RESUME_ANALYSIS {
        uuid id PK
        uuid resume_id FK
        uuid target_jd_id FK
        float ats_score
        float dense_similarity
        float keyword_recall
        jsonb extracted_skills
        jsonb layout_boxes
        jsonb feedback_remediation
    }

    JOB_DESCRIPTION {
        uuid id PK
        string role_title
        string company_tier
        text raw_description
        jsonb required_skills
        string embedding_id
    }

    INTERVIEW {
        uuid id PK
        uuid student_id FK
        string target_role
        string session_token
        string status
        timestamp conducted_at
    }

    INTERVIEW_ANALYSIS {
        uuid id PK
        uuid interview_id FK
        float mock_score
        float speech_rate_wpm
        float filler_ratio
        float visual_confidence
        text transcript_summary
        jsonb code_sandbox_verdict
    }

    LEARNING_EVENT {
        bigint id PK
        uuid student_id FK
        string event_type
        string concept_node_id
        int duration_seconds
        jsonb telemetry_payload
        timestamp recorded_at
    }

    PREDICTION {
        uuid id PK
        uuid student_id FK
        uuid spv_id FK
        uuid model_version_id FK
        float calibrated_probability
        string assigned_tier
        jsonb trajectory_quantiles
        timestamp predicted_at
    }

    EXPLANATION {
        uuid id PK
        uuid prediction_id FK
        jsonb shap_attributions
        jsonb dice_counterfactuals
        jsonb top_risk_factors
    }

    SKILL {
        string concept_id PK
        string concept_name
        string domain
        jsonb parent_prerequisites
        int estimated_cognitive_hours
    }

    SKILL_GAP {
        uuid id PK
        uuid student_id FK
        uuid target_jd_id FK
        float overall_distance
        jsonb deficit_matrix
        timestamp evaluated_at
    }

    RECOMMENDATION {
        uuid id PK
        uuid skill_gap_id FK
        string concept_id FK
        int priority_rank
        float cost_effort
        string prerequisite_status
    }

    ROADMAP {
        uuid id PK
        uuid student_id FK
        int total_sprints
        jsonb weekly_milestones
        float completion_percentage
        string status
        timestamp generated_at
    }

    QUESTION {
        uuid id PK
        string concept_id FK
        text stem_text
        jsonb options
        int correct_option_index
        jsonb distractor_misconceptions
        float calibrated_difficulty
    }

    QUESTION_ATTEMPT {
        uuid id PK
        uuid assessment_id FK
        uuid question_id FK
        int selected_option
        boolean is_correct
        int response_time_ms
        int hints_requested
    }

    MODEL_VERSION {
        uuid id PK
        string model_name
        string version_tag
        string artifact_hash
        jsonb evaluation_metrics
        boolean is_active
        timestamp registered_at
    }

    EXPERIMENT_REFERENCE {
        uuid id PK
        string experiment_id
        string hypothesis_tested
        jsonb control_group_ids
        jsonb experimental_group_ids
        jsonb observed_metrics
        timestamp executed_at
    }